{
  "log": {
    "version": "1.2",
    "creator": {
      "name": "qa-trace demo capture",
      "comment": "登录锁定演示库的抓包证据；真实项目放浏览器导出的 HAR"
    },
    "entries": [
      {
        "startedDateTime": "2026-10-18T13:00:41.000Z",
        "request": {
          "method": "POST",
          "url": "https://shop.example.test/api/login",
          "headers": [{ "name": "content-type", "value": "application/json" }],
          "postData": {
            "mimeType": "application/json",
            "text": "{\"username\":\"qa01\",\"password\":\"Wrong@123\"}"
          }
        },
        "response": {
          "status": 401,
          "statusText": "Unauthorized",
          "headers": [{ "name": "content-type", "value": "application/json" }],
          "content": {
            "mimeType": "application/json",
            "text": "{\"message\":\"用户名或密码错误\",\"remaining\":0}"
          }
        },
        "comment": "第 5 次失败：需求要求 423 + 锁定，实测仍是 401（缺陷 LOGIN-311）"
      }
    ]
  }
}
